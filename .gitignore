# Virtual environment
venv/
.venv/
env/

# ChromaDB (regenerated by ingest.py, don't commit the database itself)
chroma_db/

# Python cache
__pycache__/
*.pyc
*.pyo

# deepeval's local cache/config — unrelated to this project, may contain tokens
.deepeval/
.deepeval_cache.json

# Environment variables / secrets — never commit these
.env
.env.local

# OS-generated junk
.DS_Store
Thumbs.db

# Editor folders
.vscode/
.idea/